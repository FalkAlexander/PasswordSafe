{
    "name": "python3-zxcvbn-rs-py",
    "buildsystem": "simple",
    "build-commands": [
        "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"zxcvbn-rs-py\" --no-build-isolation"
    ],
    "modules": [
        "maturin.json"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/python3-zxcvbn-rs-py/cargo",
            "CARGO_NET_OFFLINE": "true",
            "RUST_BACKTRACE": "1"
        }
    },
    "sources": [
        "python3-zxcvbn-rs-py-sources.json",
        {
            "type": "file",
            "url": "https://files.pythonhosted.org/packages/9b/ee/8dd05d25e5c259d90b194f30e2ed25213fa11f65999842ba268f62d4543c/zxcvbn_rs_py-0.3.0.tar.gz",
            "sha256": "d2742680823a174823f070a734074bbe8c1604f1313c08170b158026e36c73a0"
        }
    ]
}
